<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZebraScanner.Scanner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Core palette -->
        <item name="colorPrimary">@color/scanner_primary</item>
        <item name="colorPrimaryVariant">@color/scanner_primary_variant</item>
        <item name="colorOnPrimary">@color/scanner_onPrimary</item>
        <item name="colorSecondary">@color/scanner_secondary</item>
        <item name="colorSecondaryVariant">@color/scanner_secondary_variant</item>
        <item name="colorOnSecondary">@color/scanner_onSecondary</item>

        <item name="android:colorBackground">@color/scanner_background</item>
        <item name="colorSurface">@color/scanner_surface</item>
        <item name="colorOnBackground">@color/scanner_onBackground</item>

        <!-- Typography: using system defaults but emphasize clarity -->
        <item name="textAppearanceHeadline6">?attr/textAppearanceHeadline6</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>

        <!-- Elevation and shapes for a subtle premium feel -->

    </style>

    <!-- Small rounded cards used in scanner overlays -->
    <style name="Scanner.OverlayCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardBackgroundColor">@color/scanner_surface</item>
    </style>

    <!-- Floating action button tuned for scanner actions -->
    <style name="Scanner.FAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/scanner_secondary</item>
        <item name="rippleColor">@color/scanner_onSecondary</item>
        <item name="fabSize">normal</item>
        <item name="elevation">6dp</item>
    </style>
</resources>
